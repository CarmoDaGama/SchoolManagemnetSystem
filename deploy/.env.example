NODE_ENV=production
PORT=3100
DATABASE_URL="mysql://transporte_app:TROCAR_SENHA_FORTE@127.0.0.1:3306/transporte"
JWT_SECRET=GERAR_64_CARACTERES_ALEATORIOS
WEB_DIR=web
# Cópias de segurança feitas pela aplicação (hora, pastas e retenção configuradas no sistema)
MYSQLDUMP_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe"
MYSQL_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe"
MYSQL_CNF=C:\TransporteApp\scripts\backup.cnf
BACKUP_DIR_INICIAL=C:\TransporteApp\backups
# senha inicial do admin criada pelo seed (trocar na formação)
ADMIN_SENHA=TROCAR_SENHA_ADMIN
# sem internet: impedir o Prisma de tentar contactar servidores
CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1
