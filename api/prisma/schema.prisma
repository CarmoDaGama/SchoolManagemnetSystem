generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
}

enum Genero {
  M
  F
}

enum Turno {
  MANHA
  TARDE
  MANHA_E_TARDE
}

enum Sentido {
  IDA_E_VOLTA
  SO_IDA
  SO_VOLTA
}

enum TipoInscricao {
  NOVA
  CONFIRMACAO
}

enum EstadoInscricao {
  ACTIVA
  SUSPENSA
  CANCELADA
}

enum TipoCobranca {
  INSCRICAO
  CONFIRMACAO
  MENSALIDADE
}

enum EstadoCobranca {
  PENDENTE
  PAGA
  ISENTA
  ANULADA
}

enum MetodoPagamento {
  NUMERARIO
  TPA
  TRANSFERENCIA
  MULTICAIXA_EXPRESS
}

enum EstadoPagamento {
  VALIDO
  ANULADO
}

enum TipoMulta {
  PERCENTAGEM
  VALOR_FIXO
}

enum OrigemBackup {
  AGENDADO
  MANUAL
  ANTES_RESTAURO
}

model Utilizador {
  id         Int         @id @default(autoincrement())
  nome       String
  username   String      @unique
  senhaHash  String
  role       Role        @default(OPERADOR)
  activo     Boolean     @default(true)
  criadoEm   DateTime    @default(now())
  pagamentos Pagamento[] @relation("PagamentoRegistadoPor")
  anulacoes  Pagamento[] @relation("PagamentoAnuladoPor")
  logs       AuditLog[]
}

model Empresa {
  id              Int       @id @default(1)
  nome            String
  nif             String?
  endereco        String?
  telefone        String?
  email           String?
  logotipo        String?   @db.LongText // data URI redimensionado no browser
  moeda           String    @default("Kz")
  diaLimite       Int       @default(10) // dia de vencimento; meses curtos usam o último dia
  diasTolerancia  Int       @default(0)
  tipoMulta       TipoMulta @default(PERCENTAGEM)
  multaValor      Decimal   @default(0) @db.Decimal(12, 2)
  taxaInscricao   Decimal   @default(0) @db.Decimal(12, 2) // 0 = não cobra
  taxaConfirmacao Decimal   @default(0) @db.Decimal(12, 2)
  configurada     Boolean   @default(false)
  actualizadoEm   DateTime  @updatedAt
}

model AnoLectivo {
  id           Int         @id @default(autoincrement())
  nome         String      @unique // "2026/2027"
  anoInicio    Int // 2026
  mesInicio    Int         @default(9) // 1.º mês cobrado (9 = Setembro)
  mesesServico Int         @default(10) // nº de mensalidades no ano
  activo       Boolean     @default(false)
  inscricoes   Inscricao[]
}

model Rota {
  id                Int         @id @default(autoincrement())
  codigo            String      @unique // "R01"
  nome              String // "Talatona – Morro Bento"
  turno             Turno       @default(MANHA_E_TARDE)
  motorista         String?
  telefoneMotorista String?
  viatura           String?
  capacidade        Int         @default(30)
  valorMensal       Decimal     @db.Decimal(12, 2)
  paragens          String?     @db.Text
  activa            Boolean     @default(true)
  inscricoes        Inscricao[]
}

model Encarregado {
  id          Int     @id @default(autoincrement())
  nome        String
  telefone    String
  telefoneAlt String?
  email       String?
  parentesco  String?
  morada      String?
  alunos      Aluno[]

  @@index([nome])
  @@index([telefone])
}

model Aluno {
  id              Int          @id @default(autoincrement())
  numero          String       @unique // "T-00001"
  nome            String
  dataNascimento  DateTime?    @db.Date
  genero          Genero?
  colegio         String?
  classe          String?
  turma           String?
  morada          String?
  pontoReferencia String?
  observacoes     String?      @db.Text // alergias, quem pode receber
  encarregadoId   Int?
  encarregado     Encarregado? @relation(fields: [encarregadoId], references: [id])
  inscricoes      Inscricao[]
  criadoEm        DateTime     @default(now())

  @@index([nome])
}

model Inscricao {
  id            Int             @id @default(autoincrement())
  alunoId       Int
  anoLectivoId  Int
  rotaId        Int
  tipo          TipoInscricao   @default(NOVA)
  estado        EstadoInscricao @default(ACTIVA)
  sentido       Sentido         @default(IDA_E_VOLTA)
  pontoRecolha  String?
  horaRecolha   String? // "06:40"
  mesEntrada    DateTime        @db.Date // 1.º dia do mês em que começou
  valorMensal   Decimal         @db.Decimal(12, 2)
  valorEspecial Boolean         @default(false)
  motivoValor   String?
  data          DateTime        @default(now())
  aluno         Aluno           @relation(fields: [alunoId], references: [id])
  anoLectivo    AnoLectivo      @relation(fields: [anoLectivoId], references: [id])
  rota          Rota            @relation(fields: [rotaId], references: [id])
  cobrancas     Cobranca[]
  pagamentos    Pagamento[]

  @@unique([alunoId, anoLectivoId])
  @@index([rotaId, estado])
}

model Cobranca {
  id          Int             @id @default(autoincrement())
  inscricaoId Int
  tipo        TipoCobranca
  descricao   String // "Mensalidade Outubro 2026"
  referencia  DateTime        @db.Date // mês (dia 1); para taxas, mês da inscrição
  valor       Decimal         @db.Decimal(12, 2)
  vencimento  DateTime        @db.Date
  estado      EstadoCobranca  @default(PENDENTE)
  motivo      String? // isenção / anulação
  inscricao   Inscricao       @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  itens       PagamentoItem[]

  // único: suspender/retirar marcam ANULADA; reactivar/acrescentar reabrem em vez de criar
  @@unique([inscricaoId, tipo, referencia])
  @@index([estado, vencimento])
  @@index([referencia])
}

model Pagamento {
  id             Int             @id @default(autoincrement())
  numeroRecibo   String          @unique // "RC 2026/000123"
  inscricaoId    Int
  data           DateTime        @default(now())
  metodo         MetodoPagamento
  referenciaBanc String?
  subtotal       Decimal         @db.Decimal(12, 2)
  multa          Decimal         @default(0) @db.Decimal(12, 2)
  desconto       Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  estado         EstadoPagamento @default(VALIDO)
  motivoAnulacao String?
  anuladoEm      DateTime?
  utilizadorId   Int
  anuladoPorId   Int?
  inscricao      Inscricao       @relation(fields: [inscricaoId], references: [id])
  utilizador     Utilizador      @relation("PagamentoRegistadoPor", fields: [utilizadorId], references: [id])
  anuladoPor     Utilizador?     @relation("PagamentoAnuladoPor", fields: [anuladoPorId], references: [id])
  itens          PagamentoItem[]

  @@index([data])
}

model PagamentoItem {
  id          Int       @id @default(autoincrement())
  pagamentoId Int
  cobrancaId  Int
  valor       Decimal   @db.Decimal(12, 2)
  multa       Decimal   @default(0) @db.Decimal(12, 2)
  pagamento   Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)
  cobranca    Cobranca  @relation(fields: [cobrancaId], references: [id])
}

model ConfigBackup {
  id            Int      @id @default(1)
  activo        Boolean  @default(true)
  hora          String   @default("13:00") // HH:mm
  pastaLocal    String   @default("C:\\TransporteApp\\backups")
  pastaExterna  String? // ex.: "E:\\CopiasTransporte" (pen)
  retencaoDias  Int      @default(30)
  actualizadoEm DateTime @updatedAt
}

model RegistoBackup {
  id             Int          @id @default(autoincrement())
  origem         OrigemBackup
  inicio         DateTime     @default(now())
  fim            DateTime?
  sucesso        Boolean      @default(false)
  ficheiro       String?
  tamanhoBytes   Int?
  copiadoExterno Boolean      @default(false)
  aviso          String?      @db.Text
  utilizadorId   Int? // null = agendado

  @@index([inicio])
}

model Sequencia {
  chave String @id // "recibo-2026", "aluno"
  valor Int    @default(0)
}

model AuditLog {
  id           Int         @id @default(autoincrement())
  utilizadorId Int?
  accao        String // "PAGAMENTO_ANULADO", "MES_ISENTO", "VALOR_ALTERADO"
  entidade     String
  entidadeId   String
  dados        String?     @db.LongText // JSON em texto: o MySQL 5.6 não tem o tipo JSON
  criadoEm     DateTime    @default(now())
  utilizador   Utilizador? @relation(fields: [utilizadorId], references: [id])

  @@index([entidade, entidadeId])
}
