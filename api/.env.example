NODE_ENV=development
PORT=3100
# root só em desenvolvimento: o prisma migrate dev precisa de criar a shadow database
DATABASE_URL="mysql://root:root@127.0.0.1:3307/transporte"
JWT_SECRET=dev-secret-trocar-em-producao
WEB_DIR=../web/out
CORS_ORIGIN=http://localhost:3000
# Desenvolvimento: mysqldump/mysql correm dentro do contentor (docker-compose.yml)
BACKUP_DOCKER_CONTAINER=transporte-mysql
BACKUP_DIR_INICIAL=./backups
# Produção (Windows): ver deploy/.env.example
# MYSQLDUMP_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe"
# MYSQL_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe"
# MYSQL_CNF=C:\TransporteApp\scripts\backup.cnf
CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1
